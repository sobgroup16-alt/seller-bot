# ============================================================
#  НАСТРОЙКИ БОТА. Скопируйте этот файл в .env и заполните.
#  На Bothost эти же строки вводятся в панели: «Переменные окружения».
#  ✍️ — нужно вписать ваше значение. Пустые строки = функция выключена.
#  Оплаты в боте нет: курс оплачивается на лендинге (Prodamus).
# ============================================================

# ✍️ Токен от @BotFather. На Bothost его вводят при создании бота, здесь можно не писать.
BOT_TOKEN=

# ✍️ Ваш chat id (число). Узнать: напишите своему боту /myid. Несколько — через запятую.
# Нужен для /stats и /broadcast.
ADMIN_ID=

# ---------- Лид-магниты ----------
# ✍️ Ссылка на видео «5 утечек магазина» (YouTube, VK Видео, Rutube, Яндекс Диск и т.п.)
LEAD_UTECHKI_URL=
# или file_id видео в Telegram (пришлите видео боту — он ответит file_id). Если заполнен, важнее ссылки.
LEAD_UTECHKI_FILE_ID=
# ✍️ Ссылка на видео «Создай агента за вечер»
LEAD_AGENT_URL=
LEAD_AGENT_FILE_ID=

# ---------- Ссылки ----------
# ✍️ Адрес лендинга курса, например https://ваш-сайт.ru/course
# Кнопка «Посмотреть программу» откроет его на блоке программы: ...?src=utechki#program
LANDING_URL=
# ✍️ Ссылка на ваш Telegram-канал, например https://t.me/имя_канала
CHANNEL_URL=

# ---------- Отложенные сообщения (часы после видео; 0 = не отправлять) ----------
# Приглашение в канал (отправится, только если заполнен CHANNEL_URL)
CHANNEL_INVITE_DELAY_HOURS=2
# Прогрев 1: ваша история
WARMUP1_DELAY_HOURS=24
# Прогрев 2: ответы на сомнения
WARMUP2_DELAY_HOURS=60
# Не писать ночью: сообщения уходят только с SEND_FROM_HOUR до SEND_TO_HOUR по этому часовому поясу
TIMEZONE=Europe/Moscow
SEND_FROM_HOUR=10
SEND_TO_HOUR=21
# Как часто бот проверяет очередь (секунды)
SCHEDULER_INTERVAL_SECONDS=60

# ---------- Рассылка ----------
# Сколько сообщений в секунду при рассылке. Telegram разрешает около 30, бот не даст поставить больше 20.
BROADCAST_RATE_PER_SEC=15

# ---------- База ----------
# Обычно не трогать. На Bothost база сама ляжет в /app/data (DATA_DIR) — эта папка не стирается.
# DB_PATH=/app/data/bot.sqlite3
